# Build de production : bundle Vite via Bun, puis service statique nginx.
FROM oven/bun:1.0 AS build

WORKDIR /app

COPY package.json bun.lockb* ./
RUN bun install

COPY . .

# URL publique de l'API, bakée dans le bundle (import.meta.env.VITE_API_URL).
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

RUN bun run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
# Porte de maintenance : génère /etc/nginx/maintenance_gate.conf au démarrage
# (lu par l'entrypoint officiel nginx) à partir de MAINTENANCE_MODE / ALLOW_MAINTENANCE_IPS.
COPY docker-maintenance-gate.sh /docker-entrypoint.d/40-maintenance-gate.sh
RUN chmod +x /docker-entrypoint.d/40-maintenance-gate.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
