# Build de production : bundle Vite via Bun, puis service statique nginx.
FROM oven/bun:1.0 AS build

WORKDIR /app

COPY package.json bun.lockb* ./
RUN bun install

COPY . .

# URL publique de l'API, bakée dans le bundle (import.meta.env.VITE_API_URL).
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# SSO Google : Client ID public baké dans le bundle (vide = bouton masqué).
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

# Turnstile (démo publique /demo) : site key PUBLIQUE bakée dans le bundle.
# Vide = pas de captcha affiché (le serveur ignore alors la vérification).
ARG VITE_TURNSTILE_SITE_KEY
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}

# ⚠ Bun ne positionne pas NODE_ENV=production au build (quirk vite+bun) :
# sans ça, @vitejs/plugin-react n'est pas en mode prod et émet le runtime JSX
# DEV (jsxDEV), alors que le `define` de vite.config résout les libs React en
# PROD où react/jsx-dev-runtime exporte jsxDEV=undefined => "jsxDEV is not a
# function" en prod. On force NODE_ENV ici (après bun install pour garder les
# devDeps), ce qui aligne plugin-react sur le runtime JSX de prod (jsx/jsxs).
ENV NODE_ENV=production

RUN bun run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
# Porte de maintenance : génère /etc/nginx/maintenance_gate.conf au démarrage
# (lu par l'entrypoint officiel nginx) à partir de MAINTENANCE_MODE / ALLOW_MAINTENANCE_IPS.
COPY docker-maintenance-gate.sh /docker-entrypoint.d/40-maintenance-gate.sh
RUN chmod +x /docker-entrypoint.d/40-maintenance-gate.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
