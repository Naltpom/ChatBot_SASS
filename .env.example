# ===================================
# Configuration Base de Donnees
# ===================================
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_DB=chatbot_saas
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_secret@db:5432/chatbot_saas

# ===================================
# Securite
# ===================================
# JWT pour l'auth dashboard ET les tokens de session widget (courte duree)
JWT_SECRET_KEY=change-me-minimum-32-caracteres-en-production
# Cle Fernet pour chiffrer les secrets clients (cles BYOK, secrets captcha).
# Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===================================
# Cles IA "managed" (mode cle geree par le SaaS)
# Les clients BYOK stockent leur propre cle, chiffree en base.
# ===================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Mode mock : true = reponses IA simulees (dev sans cle, zero cout)
MOCK_AI=true

# ===================================
# Prospection commerciale (back-office superadmin). API publique gratuite
# recherche-entreprises (SIRENE) : aucune cle requise. Le brouillon d'email
# reutilise ANTHROPIC_API_KEY (ou MOCK_AI), l'envoi reutilise la config SMTP.
# ===================================
PROSPECTING_ENABLED=true
RECHERCHE_ENTREPRISES_URL=https://recherche-entreprises.api.gouv.fr/search
# Plafonds du crawl d'enrichissement (par prospect)
PROSPECT_CRAWL_MAX_PAGES=6
PROSPECT_CRAWL_MAX_REDIRECTS=4
PROSPECT_FETCH_MAX_BYTES=300000
# Cle Brave Search, gratuite, vide=decouverte web off, repli SIRENE
BRAVE_SEARCH_API_KEY=

# ===================================
# Captcha par defaut (Turnstile, nos cles incluses dans le plan).
# Les clients peuvent surcharger avec reCAPTCHA v3 + leurs cles, ou desactiver.
# La meme cle protege aussi la demo publique /demo (cle SECRET ci-dessous +
# VITE_TURNSTILE_SITE_KEY ci-apres). Vides = captcha ignore (dev).
# ===================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Site key PUBLIQUE bakee dans le bundle front (widget Turnstile de /demo).
# = TURNSTILE_SITE_KEY. Vide = pas de captcha affiche sur la demo.
VITE_TURNSTILE_SITE_KEY=

# ===================================
# Demo publique « 1 URL -> chatbot » (page /demo, sans auth). Defauts sains :
#  DEMO_ENABLED=false coupe la fonctionnalite (l'endpoint repond 404).
#  DEMO_IP_PER_DAY : generations REELLES / IP / 24h (cache hit non compte).
#  DEMO_GLOBAL_PER_DAY : plafond global de generations IA / 24h (coupe-circuit cout).
#  DEMO_CACHE_TTL_DAYS : duree de validite du cache url->arbre.
# /!\ EN PRODUCTION (ENV!=dev) la demo EXIGE une cle Turnstile : sans
#     TURNSTILE_SECRET_KEY (+ VITE_TURNSTILE_SITE_KEY baké, par defaut =
#     TURNSTILE_SITE_KEY), la demo reste DESACTIVEE (404) — l'endpoint etant
#     public et payant (IA), le captcha en est la barriere anti-cout. Renseigne
#     TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY ci-dessus pour l'activer.
# ===================================
DEMO_ENABLED=true
DEMO_IP_PER_DAY=5
DEMO_GLOBAL_PER_DAY=300
DEMO_CACHE_TTL_DAYS=14
# Chat IA de la demo (V2) : vraies reponses bornees au contenu scrape. Quotas
# PAR MESSAGE (chaque message = 1 appel Gemini ; le captcha de la generation
# d'arbre sert d'ouverture de session, pas de captcha par message).
DEMO_CHAT_IP_PER_DAY=30
DEMO_CHAT_GLOBAL_PER_DAY=2000

# ===================================
# SSO Google (« Continuer avec Google »)
# Client ID OAuth (PUBLIC). Même valeur dans les deux variables :
#   GOOGLE_CLIENT_ID      -> API (audience attendue des tokens)
#   VITE_GOOGLE_CLIENT_ID -> bundle front (affiche le bouton)
# Vide = SSO désactivé. Mise en place : docs/GOOGLE_SSO_SETUP.md
# ===================================
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ===================================
# Module TikTok « Chapote Publisher » (Espace client /app/tiktok)
# ===================================
# Clés de l'app TikTok (Login Kit + Content Posting API). Vides = module
# désactivé. Le secret reste côté API (jamais dans le bundle front). Les jetons
# des comptes TikTok des clients sont stockés chiffrés en base, jamais ici.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à la redirect URI déclarée dans l'app TikTok.
TIKTOK_REDIRECT_URI=https://chapote.fr/tiktok/callback
# Taille max d'une vidéo envoyée à Chapote, en Mo (défaut 1024, plafond TikTok 4 Go).
TIKTOK_MAX_UPLOAD_MB=1024
# Jeton de service (Bearer) de la chaîne de production (claude-cloud) : publie
# au nom de TIKTOK_SERVICE_USER_EMAIL, sur ses comptes TikTok connectés. Ne sert
# qu'à publier (comptes, creator-info, posts) ; vide = refusé. `openssl rand -hex 32`.
TIKTOK_SERVICE_TOKEN=
TIKTOK_SERVICE_USER_EMAIL=

# ===================================
# Module YouTube « Chapote Publisher » (Shorts, Espace client /app/youtube)
# ===================================
# Client OAuth Google « Application Web » (projet Google Cloud avec l'API
# YouTube Data v3 activée). Vides = module désactivé. Les jetons des chaînes
# des clients sont stockés chiffrés en base, jamais ici.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Doit figurer EXACTEMENT dans les « URI de redirection autorisés » du client OAuth.
YOUTUBE_REDIRECT_URI=https://chapote.fr/youtube/callback
YOUTUBE_MAX_UPLOAD_MB=1024
# Envois par tenant et par 24 h (1 600 unités de quota Google chacun, 10 000 / jour par projet).
YOUTUBE_DAILY_POSTS=6
# Jeton de service (Bearer) de la chaîne de production claude-cloud : publie au nom
# de YOUTUBE_SERVICE_USER_EMAIL sur ses chaînes connectées. `openssl rand -hex 32`.
YOUTUBE_SERVICE_TOKEN=
YOUTUBE_SERVICE_USER_EMAIL=

# ===================================
# Auto-login admin en dev (ignore si ENV != dev)
# ===================================
AUTO_LOGIN_ADMIN_DEV=false
ADMIN_EMAIL=admin@kertios.com
ADMIN_PASSWORD=Admin123!

# ===================================
# SMTP (notifications email : leads + demandes de conseiller du live chat)
# SMTP_HOST vide = pas d'envoi, simple log (jamais bloquant)
# ===================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===================================
# Embeddings locaux (RAG base de connaissances) — fastembed ONNX CPU,
# aucun appel IA externe. Defauts sains, surcharge optionnelle : changer de
# modele peut changer la dimension (la base attend vector(384)) et impose de
# re-ingerer les sources. Le cache du modele (~241 Mo au premier embed) vit
# dans le volume fastembed_cache ; efface par `docker compose down -v`
# (re-download automatique non bloquant).
# ===================================
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=/var/cache/fastembed

# ===================================
# Stripe (facturation modulaire self-serve)
# Les deux clés vides = billing désactivé : billing_enabled()==False ⇒ app 100%
# gratuite, aucun gating (resolver ALL_UNLOCKED), nav facturation masquée.
# Poser STRIPE_SECRET_KEY impose STRIPE_WEBHOOK_SECRET (validate_production).
# En prod : utiliser une Restricted API Key rk_live (sk_live refusé).
# Webhook local : stripe listen --forward-to localhost:8001/api/billing/webhook
#
# NB : STRIPE_PRICE_STARTER/PRO/AGENCE ont été RETIRÉS. Le catalogue (plans IA
# ai_free/starter/growth/scale, mod_ai_byok, add-ons mod_rag/mod_inbox/
# mod_actions/mod_ab/mod_whitelabel) est désormais piloté en base
# (table billing_products, seedée par api/scripts/seed_billing_catalog.py),
# plus aucun price_id en variable d'environnement.
# ===================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Boutique de partitions (music.chapote.fr) ---
# Secret du webhook Stripe DÉDIÉ à la boutique (endpoint https://music.chapote.fr/api/music/stripe/webhook,
# événements checkout.session.*). Vide = webhook boutique refusé (503).
STRIPE_MUSIC_WEBHOOK_SECRET=
# Jeton Bearer de l'envoi des partitions par la production (claude-cloud, scripts/music_sync.py).
MUSIC_INGEST_TOKEN=
MUSIC_URL=https://music.chapote.fr

# --- Gestion des réseaux sociaux (cm.chapote.fr) ---
# Service compose `cm` (nginx) sur 127.0.0.1:${CM_PORT} ; le reverse proxy de l'hôte y envoie cm.chapote.fr.
CM_URL=https://cm.chapote.fr
CM_PORT=3003
# Clé partagée nginx de cm <-> API (vraie IP du visiteur). openssl rand -hex 32
CM_PROXY_KEY=
# Jeton Bearer de la routine Claude (claude-cloud) : planning, publications Instagram « gérées par la
# routine », chiffres Instagram. Agit au nom de CM_SERVICE_USER_EMAIL. openssl rand -hex 32
CM_SERVICE_TOKEN=
CM_SERVICE_USER_EMAIL=
# Vidéos programmées (volume cm_media) : plafond total, taille max d'une vidéo, relevé des chiffres.
CM_MEDIA_MAX_GB=50
CM_MAX_UPLOAD_MB=1024
CM_STATS_EVERY_HOURS=6
# Statistiques TikTok : à remplir SEULEMENT après validation par TikTok (sinon la connexion échoue).
TIKTOK_EXTRA_SCOPES=
# Instagram (app Meta, « API Instagram avec connexion Instagram »). Vides = comptes gérés par la routine
# seulement. Rappels à déclarer chez Meta : https://cm.chapote.fr/api/cm/instagram/deauthorize et
# https://cm.chapote.fr/api/cm/instagram/data-deletion
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://cm.chapote.fr/instagram/callback
# Bibliothèque Google Drive de cm : clé JSON du compte de service « robot », en base64
# (base64 -w0 cle.json). Les utilisateurs partagent leurs dossiers avec l'adresse du robot.
GDRIVE_SA_KEY_B64=
GDRIVE_SCAN_MINUTES=5
# Archivage des publications par cm dans le Drive de l'utilisateur (bouton « Connecter Google Drive »).
# Client OAuth « Application Web » d'un projet Google Cloud SÉPARÉ de YouTube, API Google Drive activée,
# seul droit : https://www.googleapis.com/auth/drive.file ; URI de redirection : https://cm.chapote.fr/drive/callback
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=https://cm.chapote.fr/drive/callback

# MOCK_BILLING=true : stripe_service n'émet aucun appel Stripe sortant. Le
# checkout renvoie une URL locale (?checkout=success&mock_session=cs_test_...),
# le portail une URL mock, et l'entitlement attendu est appliqué directement
# (simule checkout.session.completed) pour que les e2e vérifient
# activation/dégradation sans Stripe. Interdit en production (validate_production
# lève RuntimeError si is_production et MOCK_BILLING). Défaut dev/CI = true.
MOCK_BILLING=true

# BILLING_METERING_ENABLED : axe IA métré (Phase 2). false (défaut) = v1 blocage
# au quota, aucun item metered vendu / reporté à Stripe. true = report Stripe
# Billing Meters au-delà du quota (metering_enabled() = billing_enabled() ET ce
# flag). Refuse de démarrer si true sans STRIPE_SECRET_KEY.
BILLING_METERING_ENABLED=false

# BILLING_ENFORCE : kill-switch de l'enforcement. false (défaut) = mode observe,
# aucun gating bloquant, les manques de module sont seulement loggés
# (billing.observe) ; l'UI reste visible. true = gating actif (402 sur capacité
# payante manquante). Un bot sans entitlement reste gratuit dans tous les cas.
# Refuse de démarrer si true sans STRIPE_SECRET_KEY.
BILLING_ENFORCE=false

# ===================================
# URLs
# ===================================
ENV=dev
APP_URL=http://localhost:3001
API_URL=http://localhost:8001
VITE_API_URL=http://localhost:8001

# ===================================
# 2FA — TOTP (authenticator) + WebAuthn / passkeys
# Tout a des défauts sains : à renseigner seulement pour surcharger.
# TWOFA_ENFORCE_ADMIN=true => en PROD, un superadmin sans 2FA configurée est
# bloqué sur /api/admin/* (403 twofa_setup_required). En dev, sans effet.
# WEBAUTHN_RP_ID vide = dérivé de APP_URL (host) ; à poser seulement si le front
# n'est pas servi sur le même host que APP_URL (multi-domaine).
# ===================================
TWOFA_ISSUER=Chapote
TWOFA_ENFORCE_ADMIN=true
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Chapote

# ===================================
# Maintenance (porte nginx du service app, prod)
# ===================================
MAINTENANCE_MODE=on
ALLOW_MAINTENANCE_IPS=82.65.201.95
