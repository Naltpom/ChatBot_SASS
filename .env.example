# ===================================
# Configuration Base de Donnees
# ===================================
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_DB=chatbot_saas
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_secret@db:5432/chatbot_saas

# ===================================
# Securite
# ===================================
# JWT pour l'auth dashboard ET les tokens de session widget (courte duree)
JWT_SECRET_KEY=change-me-minimum-32-caracteres-en-production
# Cle Fernet pour chiffrer les secrets clients (cles BYOK, secrets captcha).
# Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===================================
# Cles IA "managed" (mode cle geree par le SaaS)
# Les clients BYOK stockent leur propre cle, chiffree en base.
# ===================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Mode mock : true = reponses IA simulees (dev sans cle, zero cout)
MOCK_AI=true

# ===================================
# Captcha par defaut (Turnstile, nos cles incluses dans le plan).
# Les clients peuvent surcharger avec reCAPTCHA v3 + leurs cles, ou desactiver.
# ===================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===================================
# Auth intranet Kertios (staff = superadmins du SaaS)
# ===================================
INTRANET_AUTH_URL=https://intranet.kertios.com/main/auth_ret
INTRANET_AUTH_ENABLED=true

# ===================================
# Auto-login admin en dev (ignore si ENV != dev)
# ===================================
AUTO_LOGIN_ADMIN_DEV=false
ADMIN_EMAIL=admin@kertios.com
ADMIN_PASSWORD=Admin123!

# ===================================
# SMTP (notification email des leads)
# SMTP_HOST vide = pas d'envoi, simple log (jamais bloquant)
# ===================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===================================
# Stripe (facturation self-serve)
# Vides = billing désactivé (changement de plan immédiat, garde-fous conservés).
# En production : tout-ou-rien, une config partielle refuse de démarrer.
# Webhook local : stripe listen --forward-to localhost:8001/api/billing/webhook
# ===================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# ===================================
# URLs
# ===================================
ENV=dev
APP_URL=http://localhost:3001
API_URL=http://localhost:8001
VITE_API_URL=http://localhost:8001
