#: includes/class-chapote-bo-admin.php:19
#: includes/class-chapote-bo-admin.php:127
msgid "Chapote Bot Manager"
msgstr "Chapote Bot Manager"

#. Description of the plugin
#: chapote-bot-manager.php
msgid "The Chapote chatbot inside WordPress: sign in, manage your bots, edit the appearance, pay (Stripe), enable the widget on your site and target pages. A thin UI on top of the Chapote API; the token stays server-side (never exposed to JavaScript)."
msgstr "Le chatbot Chapote dans WordPress : connectez-vous, gérez vos bots, éditez l'apparence, payez (Stripe), activez le widget sur le site et ciblez les pages. UI mince au-dessus de l'API Chapote ; le token reste côté serveur (jamais exposé au JavaScript)."

#. Author of the plugin
#: chapote-bot-manager.php
#: includes/class-chapote-bo-admin.php:20
msgid "Chapote"
msgstr "Chapote"

#. Author URI of the plugin
#: chapote-bot-manager.php
msgid "https://chapote.fr"
msgstr "https://chapote.fr"

#: chapote-bot-manager.php:81
msgid "Open Chapote Bot Manager"
msgstr "Ouvrir Chapote Bot Manager"

#: chapote-bot-manager.php:96
msgid "The Chapote Bot Manager plugin connects to the Chapote API (OAuth Authorization Code + PKCE) to manage your bots and redirects to Stripe Checkout for payment. The public widget loads a script from the configured Chapote domain."
msgstr "Le plugin Chapote Bot Manager se connecte à l'API Chapote (OAuth Authorization Code + PKCE) pour gérer vos bots et déclenche une redirection vers Stripe Checkout pour le paiement. Le widget public charge un script depuis le domaine Chapote configuré."

