{
  "expo": {
    "name": "Chapote CM",
    "slug": "chapote-cm",
    "version": "1.0.0",
    "scheme": "chapotecm",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f5f7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.chapote.cm",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choisir une vidéo de la galerie à publier.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.chapote.cm",
      "adaptiveIcon": {
        "backgroundColor": "#1d1d1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir une vidéo de la galerie à publier.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0071e3"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f5f5f7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://cm.chapote.fr",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8c39edcf-d3e1-4d15-a54e-23a3e8ebcdfd"
      }
    },
    "owner": "naltpom",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/8c39edcf-d3e1-4d15-a54e-23a3e8ebcdfd"
    }
  }
}
