{
  "expo": {
    "name": "Chapote CM",
    "slug": "chapote-cm",
    "version": "1.0.0",
    "scheme": "chapotecm",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f5f7",
    "runtimeVersion": { "policy": "appVersion" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.chapote.cm",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choisir une vidéo de la galerie à publier.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.chapote.cm",
      "adaptiveIcon": {
        "backgroundColor": "#1d1d1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-localization",
      ["expo-image-picker", { "photosPermission": "Choisir une vidéo de la galerie à publier." }],
      ["expo-notifications", { "color": "#0071e3" }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 120, "backgroundColor": "#f5f5f7", "dark": { "backgroundColor": "#000000" } }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "apiUrl": "https://cm.chapote.fr" }
  }
}
